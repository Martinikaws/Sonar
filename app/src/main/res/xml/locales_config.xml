<?xml version="1.0" encoding="utf-8"?>
<!--
    The languages the app ships. Declaring them is what puts Sonar in Android's
    per-app language picker, so the app can be read in one language while the
    phone stays in another.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="it" />
</locale-config>
