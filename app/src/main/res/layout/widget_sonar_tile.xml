<?xml version="1.0" encoding="utf-8"?>
<!-- Square widget with song information above the transport controls. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp">

            <LinearLayout
                android:id="@+id/widget_now"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_cover"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="#FFFFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#B3FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/widget_logo_target"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/widget_open_app">
                <ImageView
                    android:id="@+id/widget_logo"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="5dp"
                    android:src="@drawable/ic_app_mark" />
            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_previous_target"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/previous">
                <ImageView
                    android:id="@+id/widget_previous"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:layout_width="28dp"
                    android:layout_height="24dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_widget_previous" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_toggle_target"
                android:layout_width="44dp"
                android:layout_height="44dp">
                <ImageView
                    android:id="@+id/widget_toggle"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/widget_button_primary"
                    android:padding="11dp"
                    android:src="@drawable/ic_pip_play"
                    android:tint="#FF111114" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_next_target"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/next">
                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:layout_width="28dp"
                    android:layout_height="24dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_widget_next" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
